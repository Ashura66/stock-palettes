{% extends 'base.html.twig' %}

{% block title %}Produits{% endblock %}

{% block body %}
    <h1>Produits</h1>

    <table class="table">
        <thead>
            <tr>
                <th>SKU</th>
                <th>Nom</th>
                <th>Catégorie</th>
                <th>Unité</th>
                <th>Colis par palette</th>
                <th>Stock minimum</th>
                <th>Stock</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for product in products %}
            <tr>
                <td>{{ product.sku }}</td>
                <td>{{ product.name }}</td>
                <td>{{ product.category ? product.category.name : '-' }}</td>
                <td>{{ product.unit }}</td>
                <td>{{ product.parcelsPerPallet }}</td>
                <td>{{ product.minStock }}</td>
                <td>{{ product.currentStock }}</td>
                <td>{{ product.isActive ? 'Actif' : 'Désactivé' }}</td>
                <td>
                    <a href="{{ path('app_product_show', {'id': product.id}) }}">show</a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_product_edit', {'id': product.id}) }}">edit</a>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9">Aucun produit.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_product_new') }}">Créer un produit</a>
    {% endif %}
{% endblock %}
